# Copy to .env and fill in. Secrets are empty on purpose: `npm run setup` (or
# `node strut key:generate`) writes them into .env only. Never commit .env.

# Application
APP_NAME={{APP_NAME}}
APP_ENV=production
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL=http://localhost:3000
APP_PORT=3000
APP_LOCALE={{APP_LOCALE}}
APP_TIMEZONE={{APP_TIMEZONE}}
APP_CURRENCY={{APP_CURRENCY}}

# Database
DB_CONNECTION={{DB_CONNECTION}}
# @strut:if database is sqlite
DB_DATABASE=database/database.sqlite
DB_TEST_DATABASE=database/testing.sqlite
# For a MySQL, MariaDB or PostgreSQL server instead, set DB_CONNECTION and these:
# DB_HOST=127.0.0.1
# DB_PORT=
# DB_USERNAME=
# DB_PASSWORD=
# DB_URL=
# DB_SOCKET=
# DB_SSLMODE=
# DB_SSL_CA=
# @strut:endif
# @strut:if database not sqlite
DB_HOST={{DB_HOST}}
DB_PORT={{DB_PORT}}
DB_DATABASE={{APP_SLUG}}
DB_TEST_DATABASE={{APP_SLUG}}_test
DB_USERNAME={{DB_USERNAME}}
DB_PASSWORD=
# A full connection string instead of the keys above (it holds the password: .env only).
DB_URL=
# A Unix socket instead of host and port (MySQL/MariaDB).
DB_SOCKET=
# Remote or cloud databases: disable, prefer, require, verify-ca or verify-full, and a CA file.
DB_SSLMODE=
DB_SSL_CA=
# @strut:endif
# How long migrate waits for another run's lock: 10s, 30000 (ms) or 2min.
DB_MIGRATION_LOCK_TIMEOUT=10s

# Logging (config/logging.ts; files in storage/logs)
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14
LOG_FORMAT=line
LOG_MAX_FILE_SIZE=100mb
LOG_PATH=storage/logs
LOG_SLACK_WEBHOOK_URL=
LOG_DEPRECATIONS_CHANNEL=null

# Cache, files and sessions
CACHE_STORE=file
FILESYSTEM_DISK=local
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE={{APP_SLUG}}_session
