# Copy to .env and fill in. Secrets are empty on purpose: `npm run setup` (or
# `node strut key:generate`) writes them into .env only. Never commit .env.
#
# Every key the framework reads is listed here. An empty value means "use the default". A
# database connection or service whose keys are empty is checked only when something first uses
# it, and then fails with an error naming the key, so the app always starts.

# Application
APP_NAME={{APP_NAME}}
APP_ENV=production
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL=http://localhost:3000
APP_PORT=3000
APP_LOCALE={{APP_LOCALE}}
APP_TIMEZONE={{APP_TIMEZONE}}
APP_CURRENCY={{APP_CURRENCY}}

# Database: the default connection (models, `node strut migrate`). DB_CONNECTION is mysql,
# mariadb, pgsql (postgres is accepted too) or sqlite.
DB_CONNECTION={{DB_CONNECTION}}
# @strut:if database is sqlite
DB_DATABASE=database/database.sqlite
DB_TEST_DATABASE=database/testing.sqlite
# Ignored for sqlite. To use a MySQL, MariaDB or PostgreSQL server instead, set DB_CONNECTION
# and these (and DB_DATABASE to the database name).
DB_HOST=127.0.0.1
DB_PORT=
DB_USERNAME=
# @strut:endif
# @strut:if database not sqlite
DB_HOST={{DB_HOST}}
DB_PORT={{DB_PORT}}
DB_DATABASE={{APP_SLUG}}
DB_TEST_DATABASE={{APP_SLUG}}_test
DB_USERNAME={{DB_USERNAME}}
# @strut:endif
DB_PASSWORD=
# A full connection string instead of the keys above (it holds the password: .env only).
DB_URL=
# A Unix socket instead of host and port (MySQL/MariaDB socket file, PostgreSQL socket folder).
DB_SOCKET=
# Remote or cloud databases: disable, prefer, require, verify-ca or verify-full, and a CA file.
DB_SSLMODE=
DB_SSL_CA=
# How long migrate waits for another run's lock: 10s, 30000 (ms) or 2min.
DB_MIGRATION_LOCK_TIMEOUT=10s
# How long replaying the migrations (in a sandbox) may take: 10s, 30000 (ms) or 2min.
DB_MIGRATION_REPLAY_TIMEOUT=10s

# Extra database connections, used next to the default one: db.connection('pgsql'), a model's
# `connection: 'pgsql'` option, or `node strut migrate --database=pgsql`. They are declared in
# config/database.ts and read only when first used; DB_<NAME>_DATABASE is required then. Add your
# own name the same way: connections.reports in config/database.ts reads DB_REPORTS_*.
#
# MySQL or MariaDB: db.connection('mysql').
DB_MYSQL_HOST=127.0.0.1
DB_MYSQL_PORT=3306
DB_MYSQL_DATABASE=
DB_MYSQL_TEST_DATABASE=
DB_MYSQL_USERNAME=root
DB_MYSQL_PASSWORD=
DB_MYSQL_URL=
DB_MYSQL_SOCKET=
DB_MYSQL_SSLMODE=
DB_MYSQL_SSL_CA=

# PostgreSQL: db.connection('pgsql').
DB_PGSQL_HOST=127.0.0.1
DB_PGSQL_PORT=5432
DB_PGSQL_DATABASE=
DB_PGSQL_TEST_DATABASE=
DB_PGSQL_USERNAME=postgres
DB_PGSQL_PASSWORD=
DB_PGSQL_URL=
DB_PGSQL_SOCKET=
DB_PGSQL_SSLMODE=
DB_PGSQL_SSL_CA=

# SQLite: db.connection('sqlite'), a second file relative to the project root
# (e.g. database/reports.sqlite).
DB_SQLITE_DATABASE=
DB_SQLITE_TEST_DATABASE=

# Logging (config/logging.ts; files in storage/logs)
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14
LOG_FORMAT=line
LOG_MAX_FILE_SIZE=100mb
LOG_PATH=storage/logs
LOG_SLACK_WEBHOOK_URL=
LOG_DEPRECATIONS_CHANNEL=null

# Cache (config/cache.ts): file or memory; redis with @strutvane/redis.
CACHE_STORE=file

# Sessions (config/session.ts)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE={{APP_SLUG}}_session

# Queues: database keeps jobs in the app's database (no extra server); sync runs them at once.
QUEUE_CONNECTION=database

# Mail: log writes each message to the log instead of sending it; smtp sends through MAIL_HOST
# (a local Mailpit listens on 1025).
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME={{APP_NAME}}

# Broadcasting (live updates to browsers): log only writes the events to the log.
BROADCAST_CONNECTION=log

# Files (config/filesystems.ts): local or public; s3 with @strutvane/files
# (`node strut install:files`), which reads the AWS_* keys. S3-compatible services (MinIO, R2)
# set AWS_ENDPOINT and usually AWS_USE_PATH_STYLE_ENDPOINT=true.
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Redis: needs @strutvane/redis (`node strut install:redis`); nothing reads these without it.
# REDIS_URL (redis:// or rediss://) wins over the separate keys and holds the password.
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_TLS_CA=
REDIS_TLS_SERVERNAME=
# One prefix per app and environment when apps share a server; empty: the app name.
REDIS_PREFIX=
REDIS_CONNECT_TIMEOUT=5000
REDIS_COMMAND_TIMEOUT=5000
