{
  // This repo's own code: the manifest reader, the renderer and the tests. The strict settings
  // come from tsconfig.base.json (synced from strutvane-tooling, app-template profile: no
  // isolatedDeclarations, since nothing here is published). The app template has its own
  // tsconfig (template/tsconfig.json); the integration test type-checks a rendered copy of it
  // against a real @strutvane/framework.
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["src", "scripts", "test", "vitest.config.ts"]
}
